{
  "name": "oddmind",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@oddmind/web",
    "build": "npm run build --workspace=@oddmind/web",
    "start": "npm run start --workspace=@oddmind/web",
    "lint": "npm run lint --workspace=@oddmind/web",
    "typecheck": "npm run typecheck --workspace=@oddmind/web",
    "test": "npm run test --workspace=@oddmind/web"
  },
  "engines": {
    "node": ">=20"
  }
}
