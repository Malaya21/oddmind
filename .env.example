# Client (browser) — prefix with NEXT_PUBLIC_

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Optional — Google Analytics (future)
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server (Next.js route handlers / Admin SDK)
# Download JSON: Firebase Console → Project settings → Service accounts → Generate new private key
# Use client_email and private_key from that file. Wrap private key in quotes; keep \n as literal two chars.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional — future scheduler auth for advancePhase (Phase 9)

# SCHEDULER_API_SECRET=
